# JudgePay PayPal Edition — environment template
# คัดลอกเป็น .env แล้วใส่ค่าจริง (ห้าม commit .env ขึ้น git)

# --- PayPal sandbox (https://developer.paypal.com -> Apps & Credentials -> Sandbox) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# true = โหมดจำลองออฟไลน์ (ไม่ต้องมี credentials ก็รันเดโม่ได้)
# ถ้าเว้นว่างไว้ ระบบจะ mock อัตโนมัติเมื่อไม่มี credentials
PAYPAL_MOCK=true

# --- AI judge ---
# mock = heuristic ออฟไลน์ | openai-compatible = เรียก LLM จริง
JUDGE_LLM=mock
JUDGE_API_URL=
JUDGE_API_KEY=
JUDGE_MODEL=

# --- App ---
JUDGEPAY_DB=
FLASK_SECRET_KEY=change-me-in-production
PORT=5000
